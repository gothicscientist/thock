# No environment variables or API keys are required to run Thock locally.
# These are optional process environment overrides; the scripts do not load .env files.

# Optional YouTube Data API key for scripts/sound-videos.mjs.
# Set as a GitHub Actions secret for automated discovery. Never commit a real key.
YOUTUBE_API_KEY=

# Optional absolute path to an existing Chromium executable for browser tooling.
THOCK_BROWSER_EXECUTABLE=

# Optional build output directory. stage-site.mjs DELETES this directory before building.
# Leave unset to use dist/. Use only a disposable build directory.
THOCK_DIST=
